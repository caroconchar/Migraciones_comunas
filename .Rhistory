) %>%
pivot_longer(
cols = starts_with("ext_"),
names_to = "jugador",
values_to = "ext_acumulada"
) %>%
mutate(
jugador = as.integer(gsub("ext_", "", jugador))
)
# 3. Construir la base individual
base_individual_5 <- ext_ac_5 %>%
left_join(resultados_finales_5, by = "grupo") %>%
mutate(
stock_final = ext_acumulada + division_stock
) %>%
arrange(grupo, jugador)
View(resultados_4)
View(resultados_4)
View(resultados_4_g)
library(readxl)
library(tidyverse)
library(igraph)
library(dplyr)
library(scales)
library(sf)
library(ggraph)
setwd("C:/Users/Dccs1/OneDrive/Carolina Concha/Proyecto_Migraciones")
db <- read_excel("D5_Migracion_interna2.xlsx")
names(db)
######################################
#FILTRO POR REGION
db <- db %>%
filter(`Código región` == 13)
comunas_region <- db$`Comuna de residencia habitual actual`
# Filtrar columnas
db_region <- db %>%
select(
`Código región`,
`Comuna de residencia habitual actual`,
`Población censada`,
`No migrante interno comunal`,
`Aún no nacían (menores de 5 años)`,
all_of(intersect(comunas_region, names(db)))
)
db <- db_region
names(db)
db_corta <- db %>%
select(2:57)
migracion_comunas <- db_corta
# Reemplazar "-" por NA en las columnas 4 hasta el final
db_corta[, 4:ncol(db_corta)] <- lapply(
db_corta[, 4:ncol(db_corta)],
function(x) {
x[x == "-"] <- NA
as.numeric(x)
}
)
#Base de datos de migraciones
migracion_comunas <- migracion_comunas %>%
filter(
!is.na(.[[1]]),
trimws(as.character(.[[1]])) != ""
)
nodos <- migracion_comunas %>%
transmute(
comuna = trimws(as.character(.[[1]])),
poblacion_censada = as.numeric(.[[2]]),
no_migrantes = as.numeric(.[[3]]),
aun_no_nacian = as.numeric(.[[4]])
)
aristas <- migracion_comunas %>%
pivot_longer(
cols = 5:last_col(),
names_to = "comuna_origen",
values_to = "personas"
) %>%
mutate(
comuna_destino = as.character(.[[1]]),
personas = as.character(personas),
personas = na_if(personas, "-"),
personas = as.numeric(personas)
) %>%
filter(
!is.na(personas),
personas > 0,
comuna_origen != comuna_destino
) %>%
select(
comuna_origen,
comuna_destino,
personas
)
red_migracion <- graph_from_data_frame(
d = aristas %>%
rename(
from = comuna_origen,
to = comuna_destino,
weight = personas
),
directed = TRUE,
vertices = nodos %>%
rename(name = comuna)
)
#Visualizacion red
set.seed(123)
plot(
red_migracion,
layout = layout_with_fr,
vertex.size = 4,
vertex.label = NA,
vertex.color = "skyblue",
edge.width = 0.5,
edge.color = adjustcolor("gray40", alpha.f = 0.3),
edge.arrow.size = 0.2,
main = "Red de migraciones internas de Chile"
)
##Flujo neto
flujos <- as_data_frame(red_migracion, what = "edges")
flujos_neto <- flujos %>%
mutate(
comuna_1 = pmin(from, to),
comuna_2 = pmax(from, to),
flujo_firmado = ifelse(
from == comuna_1,
weight,
-weight
)
) %>%
group_by(comuna_1, comuna_2) %>%
summarise(
migracion_neta = sum(flujo_firmado, na.rm = TRUE),
.groups = "drop"
)
aristas_netas <- flujos_neto %>%
filter(migracion_neta != 0) %>%
mutate(
from = ifelse(
migracion_neta > 0,
comuna_1,
comuna_2
),
to = ifelse(
migracion_neta > 0,
comuna_2,
comuna_1
),
weight = abs(migracion_neta)
) %>%
select(from, to, weight)
nodos <- as_data_frame(
red_migracion,
what = "vertices"
)
red_neta <- graph_from_data_frame(
d = aristas_netas,
directed = TRUE,
vertices = nodos
)
set.seed(123)
plot(
red_neta,
layout = layout_with_fr,
vertex.size = 5,
vertex.label = NA,
vertex.color = "skyblue",
edge.color = adjustcolor("steelblue", alpha.f = 0.4),
edge.width = 0.5 + 3 * E(red_neta)$weight /
max(E(red_neta)$weight),
edge.arrow.size = 0.25,
main = "Red de migración neta entre comunas"
)
#DIFERENCIAR NODOS POR BALANCE
resumen_nodos <- tibble(
comuna = V(red_neta)$name,
llegadas_netas = strength(
red_neta,
mode = "in",
weights = E(red_neta)$weight
),
salidas_netas = strength(
red_neta,
mode = "out",
weights = E(red_neta)$weight
)
) %>%
mutate(
balance_neto = llegadas_netas - salidas_netas
)
resumen_nodos <- resumen_nodos %>%
mutate(
tipo = case_when(
balance_neto > 0 ~ "Receptora neta",
balance_neto < 0 ~ "Expulsora neta",
TRUE ~ "Equilibrada"
)
)
# Asegurar que los colores coincidan con los nodos
colores_balance <- c(
"#922B21",  # Salidas altas
"#E74C3C",  # Salidas medias
"#F1948A",  # Salidas bajas
"#E5E5E5",  # Balance cero
"#A9DFBF",  # Llegadas bajas
"#2ECC71",  # Llegadas medias
"#196F3D"   # Llegadas altas
)
resumen_nodos <- resumen_nodos %>%
mutate(
categoria = cut(
balance_neto,
breaks = c(-Inf, -1000, -500, 0, 500, 1000, Inf),
labels = c(
"Salidas altas",
"Salidas medias",
"Salidas bajas",
"Llegadas bajas",
"Llegadas medias",
"Llegadas altas"
),
right = TRUE
)
)
resumen_nodos <- resumen_nodos %>%
mutate(
color = case_when(
balance_neto < -4000 ~ colores_balance[1],
balance_neto < -2000  ~ colores_balance[2],
balance_neto < 0     ~ colores_balance[3],
balance_neto == 0   ~ colores_balance[4],
balance_neto <= 2000  ~ colores_balance[5],
balance_neto <= 4000 ~ colores_balance[6],
balance_neto > 4000  ~ colores_balance[7]
)
)
colores_nodos <- resumen_nodos$color[
match(V(red_neta)$name, resumen_nodos$comuna)
]
set.seed(123)
#sin etiqueta
plot(
red_neta,
layout = layout_with_fr,
vertex.size = 8,
vertex.label = NA,
vertex.color = colores_nodos,
vertex.frame.color = "grey50",
edge.color = adjustcolor("grey40", alpha.f = 0.25),
edge.width = 0.5,
edge.arrow.size = 0.2,
main = "Red de migración neta entre comunas"
)
plot(
red_neta,
layout = layout_with_fr,
vertex.size = 8,
vertex.label = V(red_neta)$name,
vertex.label.cex = 0.6,
vertex.label.color = "black",
vertex.label.dist = 1.2,
vertex.label.family = "sans",
vertex.color = colores_nodos,
vertex.frame.color = "grey50",
edge.color = adjustcolor("grey40", alpha.f = 0.25),
edge.width = 0.5,
edge.arrow.size = 0.2,
main = "Red de migración neta entre comunas"
)
